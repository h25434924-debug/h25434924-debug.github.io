  <script>
    let seconds = 10;
    const btn = document.getElementById('copyBtn');
    const timerText = document.getElementById('timerText');
    const interval = setInterval(() => {
      seconds--;
      if (seconds <= 0) {
        clearInterval(interval);
        btn.disabled = false;
        btn.textContent = 'Copiar Script';
        timerText.textContent = 'Pronto! Clique para copiar.';
      } else {
        btn.textContent = `Aguarde ${seconds}s...`;
      }
    }, 1000);
    btn.addEventListener('click', () => {
      const code = document.getElementById('scriptCode').textContent;
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = 'Copiado!';
        setTimeout(() => { btn.textContent = 'Copiar Script'; }, 2000);
      });
    });
  </script>

